# copy to .env and fill in — .env is gitignored, never commit real secrets
TELEGRAM_BOT_TOKEN=123456:your-telegram-bot-token
GEMINI_API_KEY=AQ.your-gemini-key   # AQ. prefix -> raw REST only, no SDK
DATABASE_URL=postgresql://postgres:password@localhost:5432/deadlinebot
BOT_TZ=Asia/Kolkata                  # anchors date resolution; defaults to UTC
WEBHOOK_SECRET=some-long-random-string   # Telegram secret_token for the webhook route (web.py)
PUBLIC_BASE_URL=https://your-app.onrender.com   # base for private board links, no trailing slash
